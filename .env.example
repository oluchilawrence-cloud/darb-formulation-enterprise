# ---------------------------------------------------------------------------
# Environment variables for DARB Formulation Enterprise
# Copy this file to .env and fill in verified values.
# NEVER commit the real .env file — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# WhatsApp number for click-to-chat (international format, no "+").
# Example: 2348012345678
VITE_WHATSAPP_NUMBER=234PLACEHOLDER

# Pre-filled WhatsApp message (do not URL-encode here; the app encodes it).
VITE_WHATSAPP_MESSAGE=Hello DARB Formulation Enterprise, I would like to know more about your cleaning products.

# Supabase configuration (Phase 3 — connect when dynamic content is needed)
# Get these from your Supabase project settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Business contact (Phase 1 uses static data; these override data/businessInfo.js)
VITE_BUSINESS_PHONE=
VITE_BUSINESS_EMAIL=
